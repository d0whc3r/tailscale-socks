# tailscale-socks configuration.
#
# Copy to one of these, then edit:
#   ~/.tailscale/.env       shared by every invocation
#   .env next to the binary takes priority over it
#
# Precedence: command line > environment > .env by the binary > ~/.tailscale/.env
# Every line below shows the built-in default; uncomment to change it.
#
# This file can hold an auth key. Keep it private:  chmod 600 .env

# --- Node -------------------------------------------------------------------

# Name this node registers with on the tailnet. Each hostname is a separate
# node with its own login.                                     (flag: -n)
#TSPROXY_HOSTNAME=ts-proxy

# Auth key for unattended login. Without it, the first run prints a login URL.
# Ignored once the node is logged in.                          (flag: -k)
#TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx

# Where the login is persisted.                                (flag: -D)
# Default: <user config dir>/tailscale-socks/<hostname>, e.g.
#   macOS: ~/Library/Application Support/tailscale-socks/ts-proxy
#   Linux: ~/.config/tailscale-socks/ts-proxy
#TSPROXY_STATE_DIR=/var/lib/tailscale-socks

# --- Listeners (empty value disables the listener) ---------------------------

# SOCKS5 proxy. Clients must use socks5h:// so names resolve on the tailnet.
#                                                              (flag: -s)
#TSPROXY_SOCKS5=127.0.0.1:1080

# HTTP proxy: CONNECT tunnels and plain proxied requests.      (flag: -p)
#TSPROXY_HTTP=127.0.0.1:8080

# DNS server, UDP and TCP: MagicDNS, split DNS, exit-node DNS. (flag: -d)
# Port 53 needs root and 5353 collides with mDNS, hence 5354.
#TSPROXY_DNS=127.0.0.1:5354

# --- Routing ----------------------------------------------------------------

# Send outbound traffic through an exit node:
#   auto           let Tailscale pick the best one and re-pick as needed
#   auto:any       same, written as an expression
#   auto:geo:us    restrict the automatic pick
#   <peer-name>    a specific node, by MagicDNS base name
#   100.64.0.2     a specific node, by Tailscale IP
#   off            no exit node (default)                      (flag: -e)
#TSPROXY_EXIT_NODE=off

# Keep the local LAN reachable while an exit node is in use.   (flag: -l)
#TSPROXY_EXIT_NODE_ALLOW_LAN=false

# Accept subnet routes advertised by subnet routers.           (flag: -r)
#TSPROXY_ACCEPT_ROUTES=true

# Use the tailnet DNS configuration. Required by TSPROXY_DNS.  (flag: -a)
#TSPROXY_ACCEPT_DNS=true

# --- Logging ----------------------------------------------------------------

# Also log tsnet's internal chatter.                           (flag: -v)
#TSPROXY_VERBOSE=false

# --- Read by tsnet itself, not by a flag ------------------------------------

# Control server, for Headscale and other self-hosted control planes.
#TS_CONTROL_URL=https://controlplane.tailscale.com

# Force use of TS_AUTHKEY even when the node is already logged in.
#TSNET_FORCE_LOGIN=1
